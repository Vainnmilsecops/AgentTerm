{
  "name": "@agentterm/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "AgentTerm Windows desktop shell.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsup",
    "build:renderer": "vite build",
    "smoke": "pnpm run build && electron . --smoke-test",
    "start": "pnpm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agentterm/application": "workspace:*",
    "@agentterm/shared": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "vite": "8.2.1"
  }
}
