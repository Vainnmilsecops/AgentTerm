{
  "name": "@agentterm/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "AgentTerm Windows desktop shell.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "audit:layout": "node scripts/visual-layout-audit-launcher.cjs",
    "audit:layout:test": "node --test scripts/visual-layout-audit-lib.test.cjs",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsup && tsup --config tsup.preload.config.ts",
    "build:renderer": "vite build",
    "smoke": "pnpm run build && node scripts/electron-launcher.cjs --smoke-test",
    "start": "pnpm run build && node scripts/electron-launcher.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agentterm/application": "workspace:*",
    "@agentterm/infrastructure": "workspace:*",
    "@agentterm/mcp-server": "workspace:*",
    "@agentterm/shared": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "vite": "8.2.1"
  }
}
